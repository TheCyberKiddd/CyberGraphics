include_guard(GLOBAL)

if(WIN32)
    set(CYBER_PLATFORM_WINDOWS ON)
    add_compile_definitions(CG_PLATFORM_WINDOWS=1)
elseif(APPLE)
    set(CYBER_PLATFORM_MACOS ON)
    add_compile_definitions(CG_PLATFORM_MACOS=1)
elseif(UNIX)
    set(CYBER_PLATFORM_LINUX ON)
    add_compile_definitions(CG_PLATFORM_LINUX=1)
else()
    message(FATAL_ERROR "CyberGraphics: unsupported platform")
endif()
